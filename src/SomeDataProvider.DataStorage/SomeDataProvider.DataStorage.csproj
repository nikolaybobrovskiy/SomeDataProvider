<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(ModernFramework)</TargetFramework>
    <CodeAnalysisRuleSet>i:\Dropbox\SoftConfig\VisualStudio\NBCSharpRules.ruleset</CodeAnalysisRuleSet>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="i:\Dropbox\SoftConfig\VisualStudio\StyleCop.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="*" />
    <PackageReference Include="Newtonsoft.Json" Version="*" />
    <PackageReference Include="StyleCop.Analyzers" Version="$(StyleCopAnalyzers)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="codecracker.CSharp" Version="$(CodeCrackerCSharp)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.BuiltInTypes\NBLib.BuiltInTypes.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.CodeFlow\NBLib.CodeFlow.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.DateTime\NBLib.DateTime.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.Enum\NBLib.Enum.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.HttpClient\NBLib.HttpClient.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.Logging\NBLib.Logging.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.Tasks\NBLib.Tasks.csproj" />
  </ItemGroup>

</Project>
