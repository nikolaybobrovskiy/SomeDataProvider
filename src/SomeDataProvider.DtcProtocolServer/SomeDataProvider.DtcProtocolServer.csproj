<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(ModernFramework)</TargetFramework>
    <CodeAnalysisRuleSet>i:\Dropbox\SoftConfig\VisualStudio\NBCSharpRules.ruleset</CodeAnalysisRuleSet>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="i:\Dropbox\SoftConfig\VisualStudio\StyleCop.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="McMaster.Extensions.CommandLineUtils" Version="*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="$(MicrosoftExtensionsVersion)" />
    <PackageReference Include="NetCoreServer" Version="6.2.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="$(StyleCopAnalyzers)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="codecracker.CSharp" Version="$(CodeCrackerCSharp)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="*" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.Cli\NBLib.Cli.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.CodeFlow\NBLib.CodeFlow.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.Configuration\NBLib.Configuration.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.DateTime\NBLib.DateTime.csproj" />
    <ProjectReference Include="$(NBLibRoot)\src\NBLib.Logging\NBLib.Logging.csproj" />
    <ProjectReference Include="..\SomeDataProvider.DataStorage.Definitions\SomeDataProvider.DataStorage.Definitions.csproj" />
    <ProjectReference Include="..\SomeDataProvider.DataStorage.Fred\SomeDataProvider.DataStorage.Fred.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Terminal\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Terminal\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Terminal\**" />
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Git-ignored; only present on a machine that configured a local FRED API key.
         CopyToPublishDirectory=Never keeps the real secret out of publish/release output. -->
    <None Update="appsettings.Local.json" Condition="Exists('appsettings.Local.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </None>
    <!-- Harmless placeholder; safe (and useful) to ship in both output and publish. -->
    <None Update="appsettings.Local.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
