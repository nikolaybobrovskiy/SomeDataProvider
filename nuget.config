<?xml version="1.0" encoding="utf-8"?>
<!--
  Package sources for the SomeDataProvider solution.

  Dtc.Protocol, the DTC message library from MrktPltfrm, comes only from a local folder feed, LocalNuGet; every other
  package comes only from nuget.org. The package source mapping below enforces this, so a package with a Dtc.* ID on a
  public source cannot replace the local one.

  The feed is I:\Projects\LocalNuGet. Restore needs the exact Dtc.Protocol version that
  SomeDataProvider.DtcProtocolServer.csproj pins, so put that version into the feed first: pack Dtc.Protocol from the
  MrktPltfrm commit that has that version, then run `dotnet nuget push <nupkg> -s I:\Projects\LocalNuGet`.

  To use another folder, redefine the LocalNuGet source in a NuGet.Config closer to the projects, such as
  src/NuGet.Config, which git ignores; NuGet uses the closest definition of a source:
    <configuration><packageSources><add key="LocalNuGet" value="D:\Packages\LocalNuGet" /></packageSources></configuration>
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="LocalNuGet" value="I:\Projects\LocalNuGet" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="LocalNuGet">
      <package pattern="Dtc.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
